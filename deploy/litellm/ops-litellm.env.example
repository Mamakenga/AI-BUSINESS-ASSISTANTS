# Copy this file to /home/ops/.env.ops-litellm on the VPS, then run:
# chown ops:ops /home/ops/.env.ops-litellm
# chmod 600 /home/ops/.env.ops-litellm

# Internal gateway auth key used by LiteLLM master_key and by the worker/client.
LITELLM_MASTER_KEY=replace-with-long-random-secret

# Unified provider credential used by model aliases in config.yaml.
OPENROUTER_API_KEY=

# Optional provider-specific tuning can be added here later if needed.
