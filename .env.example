PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_business_assistants
# Set to disable if your local Postgres does not use SSL.
PGSSLMODE=disable
CONTROL_API_URL=http://127.0.0.1:3000
TELEGRAM_BOT_TOKEN=
# Optional: restrict bridge processing to one Telegram group or supergroup chat id.
TELEGRAM_ALLOWED_CHAT_ID=
# Optional JSON map from Telegram message_thread_id to routing topic name.
# Bridge also learns topic names from forum_topic_created/forum_topic_edited service updates.
# Example: {"101":"00 Orchestrator","102":"01 Assistant","103":"02 Researcher"}
TELEGRAM_TOPIC_MAP=
TELEGRAM_POLL_TIMEOUT_SECONDS=30
WORKER_ROLE_IDS=orchestrator,assistant,researcher,methodist,finance_analyst,critic
WORKER_POLL_INTERVAL_MS=3000
LITELLM_BASE_URL=http://127.0.0.1:4000
# Internal token used by the worker when LiteLLM master_key is enabled.
LITELLM_API_KEY=
# Optional alias if you want the same secret name as LiteLLM config.
LITELLM_MASTER_KEY=
LITELLM_TIMEOUT_MS=60000
# Provider keys are intended for the dedicated LiteLLM env file on VPS:
# /home/ops/.env.ops-litellm
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
