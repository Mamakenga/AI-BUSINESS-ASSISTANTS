PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_business_assistants
# Set to disable if your local Postgres does not use SSL.
PGSSLMODE=disable
CONTROL_API_URL=http://127.0.0.1:3000
TELEGRAM_BOT_TOKEN=
# Optional: restrict bridge processing to one Telegram group or supergroup chat id.
TELEGRAM_ALLOWED_CHAT_ID=
# Optional JSON map from Telegram message_thread_id to routing topic name.
# Bridge also learns topic names from forum_topic_created/forum_topic_edited service updates.
# Example: {"101":"00 Orchestrator","102":"01 Assistant","103":"02 Researcher"}
TELEGRAM_TOPIC_MAP=
TELEGRAM_POLL_TIMEOUT_SECONDS=30
